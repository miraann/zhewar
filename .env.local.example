NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://zhewar.shop

# Admin panel password. Sessions are random ids stored in Upstash Redis
# (lib/adminSession.ts) — the old ADMIN_TOKEN variable is no longer used.
ADMIN_PASSWORD=

# REQUIRED in production: admin sessions live here, and every rate limit
# fails closed (503) without it. Previews need it too (NODE_ENV=production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Keys the customer access tokens (lib/customerToken.ts). Changing it logs
# every customer's device out of "my bookings". Long random string.
BOOKING_HMAC_SECRET=

# Optional: the shop's time zone, used to check booked times against the
# working schedule (lib/bookingRules.ts). Defaults to Asia/Baghdad.
SHOP_TIMEZONE=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Firebase service-account JSON (one line) for admin push notifications
FIREBASE_SERVICE_ACCOUNT=

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/cleanup-photos (vercel.json). Any long random string.
CRON_SECRET=

# Optional, local only — direct Postgres access for inspecting the database;
# the app never reads it. Use the session pooler (IPv4): the direct
# db.<ref>.supabase.co host is IPv6-only. Percent-encode special characters
# in the password (@ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
